<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:KeyClickCounter.Models">

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <Style x:Key="ToolButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ToolBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource KeyTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ToolBorderBrush}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="ToolToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource ToolBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource KeyTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ToolBorderBrush}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 单个按键单元格：上档符号 + 键名 + 计数 -->
    <DataTemplate DataType="{x:Type models:KeyItem}">
        <Border x:Name="KeyBorder"
                Width="{Binding CellWidth}" Height="{Binding CellHeight}"
                CornerRadius="5" BorderThickness="1"
                BorderBrush="{DynamicResource KeyBorderBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource KeyBgBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFlash}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource KeyFlashBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFn}" Value="True">
                            <Setter Property="Opacity" Value="0.45"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel VerticalAlignment="Center" Margin="2,0">
                <TextBlock Text="{Binding SubLabel}"
                           FontSize="9" TextAlignment="Center"
                           Foreground="{DynamicResource KeyDimBrush}"
                           Visibility="{Binding HasSubLabel, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding DisplayName}"
                           FontSize="{Binding NameFontSize}" TextAlignment="Center"
                           Foreground="{DynamicResource KeyTextBrush}"/>
                <TextBlock Text="{Binding CountText}"
                           FontSize="11" FontWeight="SemiBold" TextAlignment="Center"
                           Foreground="{DynamicResource KeyCountBrush}"/>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>