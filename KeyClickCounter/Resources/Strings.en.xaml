<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================ English ================ -->

    <!-- Toolbar -->
    <sys:String x:Key="L.ResetStats">Reset</sys:String>
    <sys:String x:Key="L.HideToTray">Hide to Tray</sys:String>
    <sys:String x:Key="L.AlwaysOnTop">Always on Top</sys:String>
    <sys:String x:Key="L.DarkTheme">Dark Theme</sys:String>
    <sys:String x:Key="L.DarkThemeTip">Check = dark theme, uncheck = light theme</sys:String>
    <sys:String x:Key="L.LangButton">中文</sys:String>
    <sys:String x:Key="L.LangTip">Switch UI language (中文 ⇄ English)</sys:String>
    <sys:String x:Key="L.PxPerCmLabel">px/cm:</sys:String>
    <sys:String x:Key="L.PxPerCmTip">Pixels-per-centimeter factor for converting cursor distance; adjust to your monitor's real DPI</sys:String>
    <sys:String x:Key="L.RangeLabel">Range:</sys:String>
    <sys:String x:Key="L.RangeStartTip">Statistics start date (default: first launch day)</sys:String>
    <sys:String x:Key="L.RangeSeparator">to</sys:String>
    <sys:String x:Key="L.RangeEndTip">Statistics end date (default: today)</sys:String>
    <sys:String x:Key="L.DefaultRange">Default Range</sys:String>
    <sys:String x:Key="L.DefaultRangeTip">Reset to: first launch day ~ today</sys:String>
    <sys:String x:Key="L.TrayHint">Minimize / close hides to tray · double-click tray icon to restore</sys:String>

    <!-- Mouse section title -->
    <sys:String x:Key="L.MouseSectionTitle">Mouse Buttons</sys:String>

    <!-- Code-generated text: status bar / live line / message box / tray -->
    <sys:String x:Key="L.HookInstallFailed">Failed to install global hooks. It may have been blocked by security software.</sys:String>
    <sys:String x:Key="L.TrayTooltipFmt">KeyClickCounter · Total {0}</sys:String>
    <sys:String x:Key="L.TrayShow">Show Window</sys:String>
    <sys:String x:Key="L.TrayReset">Reset Statistics</sys:String>
    <sys:String x:Key="L.TrayExit">Exit</sys:String>
    <sys:String x:Key="L.StatusRange">Range {0} ~ {1}</sys:String>
    <sys:String x:Key="L.StatusKeys">Keys {0}</sys:String>
    <sys:String x:Key="L.StatusMouse">Mouse {0}</sys:String>
    <sys:String x:Key="L.StatusTotal">Total {0}</sys:String>
    <sys:String x:Key="L.StatusWheel">Wheel {0} notches</sys:String>
    <sys:String x:Key="L.StatusMove">Move {0}</sys:String>
    <sys:String x:Key="L.StatusRuntime">Runtime {0}</sys:String>
    <sys:String x:Key="L.StatusOther">Other keys {0}</sys:String>
    <sys:String x:Key="L.LiveWheel">Wheel {0:N0} notches ≈ {1} rotations ({2} notches/rotation)</sys:String>
    <sys:String x:Key="L.LiveMove">Cursor moved {0} ({1:N0} px)</sys:String>

    <!-- Keycap labels -->
    <sys:String x:Key="L.Key.MouseLeft">Left</sys:String>
    <sys:String x:Key="L.Key.MouseRight">Right</sys:String>
    <sys:String x:Key="L.Key.MouseMiddle">Middle</sys:String>
    <sys:String x:Key="L.Key.MouseX1">X1</sys:String>
    <sys:String x:Key="L.Key.MouseX2">X2</sys:String>
    <sys:String x:Key="L.Key.MouseWheel">Wheel</sys:String>
    <sys:String x:Key="L.Key.Backspace">Backspace</sys:String>
    <sys:String x:Key="L.Key.CapsLock">Caps Lock</sys:String>
    <sys:String x:Key="L.Key.Enter">Enter</sys:String>
    <sys:String x:Key="L.Key.Space">Space</sys:String>
    <sys:String x:Key="L.Key.Menu">Menu</sys:String>
    <sys:String x:Key="L.Key.Num">Num</sys:String>
    <sys:String x:Key="L.Key.PrtSc">PrtSc</sys:String>
    <sys:String x:Key="L.Key.ScrLk">ScrLk</sys:String>

</ResourceDictionary>