<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="ThemeName">Dark</sys:String>

    <SolidColorBrush x:Key="WindowBgBrush" Color="#0F1116"/>
    <SolidColorBrush x:Key="PanelBgBrush" Color="#161A24"/>
    <SolidColorBrush x:Key="KeyBgBrush" Color="#1E2330"/>
    <SolidColorBrush x:Key="KeyFlashBrush" Color="#2E7DFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2E7DFF"/>
    <SolidColorBrush x:Key="KeyBorderBrush" Color="#2A3040"/>
    <SolidColorBrush x:Key="KeyTextBrush" Color="#C9D1E3"/>
    <SolidColorBrush x:Key="KeyCountBrush" Color="#53B7FF"/>
    <SolidColorBrush x:Key="KeyDimBrush" Color="#6B7385"/>
    <SolidColorBrush x:Key="ToolBgBrush" Color="#1E2330"/>
    <SolidColorBrush x:Key="ToolBorderBrush" Color="#2A3040"/>
    <SolidColorBrush x:Key="StatusTextBrush" Color="#8B93A7"/>
    <SolidColorBrush x:Key="HintTextBrush" Color="#6B7385"/>
    <SolidColorBrush x:Key="TitleBgBrush" Color="#14161C"/>
    <SolidColorBrush x:Key="TitleTextBrush" Color="#D5DAE4"/>

    <!-- DatePicker：深色适配（输入框 + 日历弹层统一走主题色） -->
    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{DynamicResource ToolBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource KeyTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ToolBorderBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CalendarStyle">
            <Setter.Value>
                <Style TargetType="Calendar">
                    <Setter Property="Background" Value="{DynamicResource PanelBgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource KeyTextBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ToolBorderBrush}"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>